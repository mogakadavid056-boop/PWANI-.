-- 5. The AI assistant is paused while the student is inside an exam
create or replace function public.ai_check_and_count()
returns integer
language plpgsql security definer set search_path = public
as $$
declare
  my_role public.app_role;
  lim integer;
  today date := (now() at time zone 'Africa/Nairobi')::date;
  used integer;
begin
  if auth.uid() is null then
    raise exception 'Please sign in to use the assistant';
  end if;

  if exists (
    select 1
    from public.quiz_attempts a
    join public.quizzes z on z.id = a.quiz_id
    where a.user_id = auth.uid()
      and a.submitted_at is null
      and z.is_exam
      and now() <= z.closes_at
      and (coalesce(z.time_limit_seconds, z.time_limit_minutes * 60) is null
           or now() <= a.started_at
                       + make_interval(secs => coalesce(z.time_limit_seconds, z.time_limit_minutes * 60))
                       + interval '1 minute')
  ) then
    raise exception 'The assistant is paused while you are in an exam.';
  end if;

  if not public.has_ai_consent() then
    raise exception 'Please accept the assistant terms first';
  end if;

  select r.role into my_role from public.user_roles r where r.user_id = auth.uid();

  lim := case my_role when 'admin' then 200 when 'lecturer' then 100 else 30 end;

  if my_role = 'student' and exists (
    select 1 from public.student_representatives sr
    where sr.user_id = auth.uid() and sr.active = true
  ) then
    lim := 50;
  end if;

  insert into public.ai_usage (user_id, day, requests)
  values (auth.uid(), today, 1)
  on conflict (user_id, day) do update set requests = public.ai_usage.requests + 1
  returning requests into used;

  if used > lim then
    raise exception 'You have used today''s % assistant questions. Please try again tomorrow.', lim;
  end if;

  return lim - used;
end;
$$;

grant execute on function public.ai_check_and_count() to authenticated;

-- 6. LECTURERS: the lecturer role is given at once with the passcode (no admin approval)
create or replace function public.become_lecturer(passcode text)
returns boolean
language plpgsql security definer set search_path = public
as $$
declare
  my_role public.app_role;
  recent_fails integer;
  stored text;
begin
  if auth.uid() is null then
    raise exception 'Authentication required';
  end if;

  select r.role into my_role from public.user_roles r where r.user_id = auth.uid();

  if my_role in ('lecturer', 'admin') then
    return true;
  end if;

  if exists (
    select 1 from public.class_members m
    where m.user_id = auth.uid() and m.status = 'active'
  ) then
    raise exception 'Students who are already in a class cannot become lecturers. Ask an administrator.';
  end if;

  select count(*) into recent_fails
  from public.passcode_attempts a
  where a.user_id = auth.uid()
    and a.success = false
    and a.attempted_at > now() - interval '1 hour';

  if recent_fails >= 5 then
    raise exception 'Too many wrong attempts. Try again in an hour.';
  end if;

  select s.value_hash into stored from public.app_secrets s where s.key = 'lecturer_passcode';

  if stored is not null
     and encode(sha256(convert_to(public.normalize_passcode(passcode), 'UTF8')), 'hex') = stored then

    update public.user_roles
    set role = 'lecturer', verified = true, updated_at = now()
    where user_id = auth.uid();

    insert into public.passcode_attempts (user_id, success) values (auth.uid(), true);

    insert into public.audit_logs (user_id, action, table_name, record_id)
    values (auth.uid(), 'become_lecturer', 'user_roles', auth.uid());

    return true;
  end if;

  insert into public.passcode_attempts (user_id, success) values (auth.uid(), false);
  return false;
end;
$$;

grant execute on function public.become_lecturer(text) to authenticated;

-- Everyone who is already a lecturer is active now. Admin can still suspend anyone later.
update public.user_roles set verified = true where role = 'lecturer';

-- Admins hear about every new lecturer (for information, no approval needed)
create or replace function public.trg_role_changed()
returns trigger
language plpgsql security definer set search_path = public
as $$
declare
  pname text;
begin
  if new.role = 'lecturer' and old.role is distinct from 'lecturer' then
    select p.full_name into pname from public.profiles p where p.id = new.user_id;

    perform public.notify_users(
      public.admin_audience(),
      'lecturer_registered',
      'New lecturer registered',
      coalesce(pname, 'Someone') || ' registered as a lecturer with the passcode.',
      null,
      jsonb_build_object('user_id', new.user_id)
    );
  end if;

  if new.role = 'lecturer' and old.role = 'lecturer' and new.verified and old.verified is distinct from true then
    perform public.notify_users(
      array[new.user_id],
      'lecturer_verified',
      'Your lecturer access is active again',
      'You can join and manage your classes with their class codes.'
    );
  end if;

  return new;
end;
$$;

-- Lecturers join classes with the class code, not by browsing a list
create or replace function public.claim_class(target_class_id uuid)
returns void
language plpgsql security definer set search_path = public
as $$
begin
  if not public.is_admin() then
    raise exception 'Lecturers join a class with its class code. Ask the class prefect or your department for the code.';
  end if;

  if not exists (select 1 from public.classes c where c.id = target_class_id) then
    raise exception 'Class not found';
  end if;

  insert into public.class_members (class_id, user_id, status)
  values (target_class_id, auth.uid(), 'active')
  on conflict (class_id, user_id) do update set status = 'active';

  insert into public.audit_logs (user_id, action, table_name, record_id)
  values (auth.uid(), 'admin_join_class', 'classes', target_class_id);
end;
$$;

grant execute on function public.claim_class(uuid) to authenticated;

-- Grades are safe: only the exam's creator, a lecturer assigned to its unit, or an admin can mark it
create or replace function public.can_mark_quiz(p_quiz uuid)
returns boolean
language sql stable security definer set search_path = public
as $$
  select coalesce((
    select public.is_admin()
        or (
          public.is_class_lecturer(qz.class_id)
          and (
            qz.created_by = auth.uid()
            or (qz.course_id is not null
                and exists (select 1 from public.course_lecturers cl
                             where cl.course_id = qz.course_id and cl.lecturer_id = auth.uid()))
          )
        )
    from public.quizzes qz
    where qz.id = p_quiz
  ), false);
$$;

grant execute on function public.can_mark_quiz(uuid) to authenticated;

-- 7. ADMIN POWERS

-- Remove a member from a class (they are told, and it is recorded)
create or replace function public.admin_remove_member(
  target_class_id uuid,
  target_user_id uuid,
  removal_reason text default null
)
returns void
language plpgsql security definer set search_path = public
as $$
declare
  cname text;
begin
  if not public.is_admin() then
    raise exception 'Only administrators can do this';
  end if;

  select c.name into cname from public.classes c where c.id = target_class_id;

  delete from public.class_members m
  where m.class_id = target_class_id and m.user_id = target_user_id;

  if not found then
    raise exception 'That person is not a member of this class';
  end if;

  update public.student_representatives sr
  set active = false
  where sr.class_id = target_class_id and sr.user_id = target_user_id;

  insert into public.audit_logs (user_id, action, table_name, record_id, metadata)
  values (auth.uid(), 'admin_remove_member', 'class_members', target_user_id,
          jsonb_build_object('class_id', target_class_id, 'reason', left(removal_reason, 300)));

  perform public.notify_users(
    array[target_user_id],
    'removed_from_class',
    'You were removed from ' || coalesce(cname, 'a class'),
    coalesce(nullif(trim(removal_reason), ''), 'If this is a mistake, please contact your lecturer or class prefect.'),
    null
  );
end;
$$;

grant execute on function public.admin_remove_member(uuid, uuid, text) to authenticated;

-- Delete one attendance session that is closed or expired (a live session must be closed first)
create or replace function public.delete_attendance_session(target_session_id uuid)
returns void
language plpgsql security definer set search_path = public
as $$
declare
  cid uuid;
  stitle text;
  still_open boolean;
  records integer;
begin
  select s.class_id, s.title, (s.active and s.expires_at > now())
  into cid, stitle, still_open
  from public.attendance_sessions s
  where s.id = target_session_id;

  if cid is null then
    raise exception 'Session not found';
  end if;

  if not (public.is_admin() or public.is_class_lecturer(cid)) then
    raise exception 'Only lecturers and administrators can delete sessions';
  end if;

  if still_open then
    raise exception 'This session is still open. Close it first.';
  end if;

  select count(*) into records from public.attendance_records r where r.session_id = target_session_id;

  delete from public.attendance_sessions s where s.id = target_session_id;

  insert into public.audit_logs (user_id, action, table_name, record_id, metadata)
  values (auth.uid(), 'delete_attendance_session', 'attendance_sessions', target_session_id,
          jsonb_build_object('class_id', cid, 'title', stitle, 'records_deleted', records));
end;
$$;

grant execute on function public.delete_attendance_session(uuid) to authenticated;

-- Admin: clear expired or closed sessions that nobody signed (started by mistake). Optional class filter.
create or replace function public.admin_delete_empty_expired_sessions(target_class_id uuid default null)
returns integer
language plpgsql security definer set search_path = public
as $$
declare
  n integer;
begin
  if not public.is_admin() then
    raise exception 'Only administrators can do this';
  end if;

  with gone as (
    delete from public.attendance_sessions s
    where (s.active = false or s.expires_at <= now())
      and not exists (select 1 from public.attendance_records r where r.session_id = s.id)
      and (target_class_id is null or s.class_id = target_class_id)
    returning s.id
  )
  select count(*) into n from gone;

  insert into public.audit_logs (user_id, action, table_name, metadata)
  values (auth.uid(), 'delete_empty_expired_sessions', 'attendance_sessions',
          jsonb_build_object('deleted', n, 'class_id', target_class_id));

  return n;
end;
$$;

grant execute on function public.admin_delete_empty_expired_sessions(uuid) to authenticated;

